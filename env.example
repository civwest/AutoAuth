# Set real values only in Render Environment, never in GitHub.
BOT_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=https://autoauth.cfd/oauth/callback
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
# DASHBOARD_ADMIN1_USER=choose_a_username
# DASHBOARD_ADMIN1_PASSWORD_HASH=PASTE_SCRYPT_HASH_HERE
# DASHBOARD_ADMIN1_PERMISSIONS=all
# Optional: DATABASE_SSL=disable

# Owner Discord user IDs (shown by name in Logs; kick-all skips them)
OWNER1_DISCORD_ID=
OWNER1_NAME=
OWNER2_DISCORD_ID=
OWNER2_NAME=
# Site personalisation (all optional; unset links are hidden)
SITE_OPERATOR=
LINK_DOCS=
LINK_TIKTOK=
LINK_YOUTUBE=
LINK_X=
LINK_TWITCH=
LINK_DISCORD=
# Optional Google Search Console file verification
GOOGLE_VERIFICATION_FILE=
# Optional Discord domain verification (value starts with dh=)
DISCORD_DOMAIN_VERIFICATION=
# Optional: days to keep DM chats (default 30, 0 = until deleted)
DM_RETENTION_DAYS=30


# Optional extra dashboard users (use Messages > Add user to generate these)
# DASHBOARD_ADMIN3_USER=
# DASHBOARD_ADMIN3_PASSWORD_HASH=
# DASHBOARD_ADMIN3_PERMISSIONS=none
# Optional: callback for dashboard sign-in with Discord (default https://YOUR-SITE/login/callback; add it in the Developer Portal too)
# LOGIN_REDIRECT_URI=https://YOUR-SITE/login/callback

# Optional: Google and X sign-in for project accounts. Each button only appears when both values are set.
# Google Cloud Console > OAuth client (Web) > add BOTH redirect URIs:
#   https://YOUR-DOMAIN/auth/google/callback
#   https://YOUR-DOMAIN/auth/google/drive/callback   (Google Drive storage)
# Also enable the Google Drive API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: a separate Google Cloud project just for Drive storage (needs only the /auth/google/drive/callback URI).
# If unset, Drive uses the client above.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# X developer console > your app > User authentication settings: OAuth 1.0a on, callback URI https://YOUR-DOMAIN/auth/x/callback
# Use the API Key and API Secret (Consumer Keys), not the OAuth 2.0 Client ID
X_API_KEY=
X_API_SECRET=

# Optional: abuse flagging for account projects (defaults shown)
FLAG_GUILDS_24H=30
FLAG_MEMBERS_1H=100

# Optional: contact email shown in the site footer (default: support@ + your domain)
# SUPPORT_EMAIL=support@example.com

# Optional: security tuning (defaults shown)
# RATE_LIMIT_PER_MIN=240
# RATE_LIMIT_AUTH_PER_MIN=20
# RATE_LIMIT_WRITE_PER_MIN=90
# RATE_LIMIT_HOOK_PER_MIN=600
# ALLOWED_HOSTS=
# Two-step login for a dashboard login (generate the secret from your profile page)
# DASHBOARD_ADMIN1_TOTP_SECRET=

# Plans and billing (Stripe). One Payment Link per plan and term: tier 1-3, term 1, 3, 6, 12 months
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_LINK_1_1=https://buy.stripe.com/...
# STRIPE_LINK_1_3= STRIPE_LINK_1_6= STRIPE_LINK_1_12=  (put each on its own line; same for STRIPE_LINK_2_* and STRIPE_LINK_3_*)
# Only if the products have no metadata tier=1|2|3: comma-separated product or price ids per tier
# STRIPE_TIER_1_IDS=
# STRIPE_TIER_2_IDS=
# STRIPE_TIER_3_IDS=
# STRIPE_PORTAL_CONFIG=bpc_...
# Receipts emailed from your own domain (Resend)
RESEND_API_KEY=
# RECEIPT_FROM=AutoAuth <noreply@autoauth.cfd>
