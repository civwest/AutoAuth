# Set real values only in Render Environment, never in GitHub.
BOT_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=https://autoauth.cfd/oauth/callback
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
# DASHBOARD_ADMIN1_USER=choose_a_username
# DASHBOARD_ADMIN1_PASSWORD_HASH=PASTE_SCRYPT_HASH_HERE
# DASHBOARD_ADMIN1_PERMISSIONS=all
# Optional: DATABASE_SSL=disable

# Owner Discord user IDs (shown by name in Logs; kick-all skips them)
OWNER1_DISCORD_ID=
OWNER1_NAME=
OWNER2_DISCORD_ID=
OWNER2_NAME=
# Site personalisation (all optional; unset links are hidden)
SITE_OPERATOR=
LINK_DOCS=
LINK_TIKTOK=
LINK_YOUTUBE=
LINK_X=
LINK_TWITCH=
LINK_DISCORD=
# Optional Google Search Console file verification
GOOGLE_VERIFICATION_FILE=
# Optional Discord domain verification (value starts with dh=)
DISCORD_DOMAIN_VERIFICATION=
# Optional: days to keep DM chats (default 30, 0 = until deleted)
DM_RETENTION_DAYS=30


# Optional extra dashboard users (use Messages > Add user to generate these)
# DASHBOARD_ADMIN3_USER=
# DASHBOARD_ADMIN3_PASSWORD_HASH=
# DASHBOARD_ADMIN3_PERMISSIONS=none
# Optional: callback for dashboard sign-in with Discord (default https://YOUR-SITE/login/callback; add it in the Developer Portal too)
# LOGIN_REDIRECT_URI=https://YOUR-SITE/login/callback

# Optional: Google and X sign-in for project accounts. Each button only appears when both values are set.
# Google Cloud Console > OAuth client (Web) > redirect URI: https://YOUR-DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X Developer Portal > OAuth 2.0 (confidential client) > callback URL: https://YOUR-DOMAIN/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional: abuse flagging for account projects (defaults shown)
FLAG_GUILDS_24H=30
FLAG_MEMBERS_1H=100
